[Unit]
Description=LUQA BEAM bench agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust User/WorkingDirectory if you cloned this somewhere other than the
# default `pi` user's home directory.
User=pi
WorkingDirectory=/home/pi/luqa-bench-beam
ExecStart=/usr/bin/node agent.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
